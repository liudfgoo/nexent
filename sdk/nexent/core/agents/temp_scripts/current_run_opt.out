思考：用户要求计算2的10到15次方，判断质数，并演示复数旋转。需要分步执行，可以用一个Python脚本依次完成三步，并打印清晰的分步输出。脚本中会使用math模块计算 
幂，判断质数的简单函数，以及使用cmath或直接计算复数乘法实现旋转。代码运行后，根据观察结果汇总回答。                                                       
                                                                                                                                                          
代码：<code>                                                                                                                                              
import math                                                                                                                                               
                                                                                                                                                          
print("===== Step 1: 计算2的10到15次方 =====")                                                                                                            
powers = []                                                                                                                                               
for n in range(10, 16):                                                                                                                                   
    val = 2 ** n                                                                                                                                          
    powers.append(val)                                                                                                                                    
    print(f"2^{n} = {val}")                                                                                                                               
                                                                                                                                                          
print("\n===== Step 2: 判断哪些是质数 =====")                                                                                                             
def is_prime(num):                                                                                                                                        
    if num < 2:                                                                                                                                           
        return False                                                                                                                                      
    for i in range(2, int(math.isqrt(num)) + 1):                                                                                                          
        if num % i == 0:                                                                                                                                  
            return False                                                                                                                                  
    return True                                                                                                                                           
                                                                                                                                                          
primes = []                                                                                                                                               
for val in powers:                                                                                                                                        
    if is_prime(val):                                                                                                                                     
        primes.append(val)                                                                                                                                
        print(f"{val} 是质数")                                                                                                                            
    else:                                                                                                                                                 
        print(f"{val} 不是质数")                                                                                                                          
                                                                                                                                                          
print(f"\n质数列表: {primes}")                                                                                                                            
                                                                                                                                                          
print("\n===== Step 3: 演示复数表示旋转 =====")                                                                                                           
# 初始向量 (1,0) 对应复数 1+0j                                                                                                                            
z_initial = 1 + 0j                                                                                                                                        
print(f"初始复数: {z_initial}")                                                                                                                           
                                                                                                                                                          
# 旋转45度 (pi/4 弧度)                                                                                                                                    
theta = math.pi / 4  # 45度                                                                                                                               
# 旋转因子: cos(theta) + i * sin(theta)                                                                                                                   
rotation_factor = complex(math.cos(theta), math.sin(theta))                                                                                               
print(f"旋转因子 (cos45° + i sin45°): {rotation_factor}")                                                                                                 
                                                                                                                                                          
# 旋转后的复数                                                                                                                                            
z_rotated = z_initial * rotation_factor                                                                                                                   
print(f"旋转后的复数: {z_rotated}")                                                                                                                       
                                                                                                                                                          
# 输出模和幅角                                                                                                                                            
mag_initial = abs(z_initial)                                                                                                                              
phase_initial = math.atan2(z_initial.imag, z_initial.real)                                                                                                
mag_rotated = abs(z_rotated)                                                                                                                              
phase_rotated = math.atan2(z_rotated.imag, z_rotated.real)                                                                                                
print(f"初始模长: {mag_initial}, 幅角: {math.degrees(phase_initial):.2f}°")                                                                               
print(f"旋转后模长: {mag_rotated}, 幅角: {math.degrees(phase_rotated):.2f}°")                                                                             
print("可见模长不变，幅角增加了45度，即实现了纯旋转。")                                                                                                   
</code>                                                                                                                                                   
