      val = 2 ** n                                                                                                                                        
      powers.append(val)                                                                                                                                  
      print(f"2^{n} = {val}")                                                                                                                             
                                                                                                                                                          
  print("\n===== Step 2: 判断哪些是质数 =====")                                                                                                           
  def is_prime(num):                                                                                                                                      
      if num < 2:                                                                                                                                         
          return False                                                                                                                                    
      for i in range(2, int(math.isqrt(num)) + 1):                                                                                                        
          if num % i == 0:                                                                                                                                
              return False                                                                                                                                
      return True                                                                                                                                         
                                                                                                                                                          
  primes = []                                                                                                                                             
  for val in powers:                                                                                                                                      
      if is_prime(val):                                                                                                                                   
          primes.append(val)                                                                                                                              
