  # 旋转复数：乘以 e^(iθ) = cos(θ) + i*sin(θ)                                                                                   
  rotation = complex(math.cos(theta), math.sin(theta))                                                                          
  z_rotated = z * rotation                                                                                                      
  print("旋转后的复数:", z_rotated)                                                                                             
                                                                                                                                
