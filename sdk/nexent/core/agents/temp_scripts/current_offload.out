  import random, hashlib                                                                                                                  
  random.seed(42)                                                                                                                         
  secret_pw = hashlib.md5(str(random.random()).encode()).hexdigest()[:12].upper()                                                         
  secret_mac = ":".join(f"{random.randint(0,255):02x}" for _ in range(6))                                                                 
  print("=== 服务器健康检查报告 ===")                                                                                                     
  for i in range(80):                                                                                                                     
      cpu = random.randint(5, 99)                                                                                                         
      mem = random.randint(10, 99)                                                                                                        
      disk = random.randint(15, 99)                                                                                                       
      uptime = random.randint(1, 365)                                                                                                     
      mac = ":".join(f"{random.randint(0,255):02x}" for _ in range(6))                                                                    
      status = "CRITICAL" if disk > 90 or cpu > 95 else ("WARNING" if disk > 80 else "OK")                                                
      print(f"server-{i:03d}: cpu={cpu}% mem={mem}% disk={disk}% status={status} uptime={uptime}d mac={mac}")                             
  print()                                                                                                                                 
